rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private progress is accessible only to the account owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validPublicProfile(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function validPublicProfile(data) {
      // Only reading information is public, even from a modified client.
      return data.keys().hasAll([
          'username', 'chaptersRead', 'maxStars', 'timesCompleted',
          'chaptersCycle', 'completedBooks', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'username', 'chaptersRead', 'maxStars', 'timesCompleted',
          'chaptersCycle', 'completedBooks', 'completedBookIds', 'updatedAt'
        ])
        && data.username is string
        && data.username.size() >= 1
        && data.username.size() <= 20
        && data.username.matches('.*[^\\s].*')
        && data.chaptersRead is int && data.chaptersRead >= 0
        && data.maxStars is int && data.maxStars >= data.chaptersRead
        && data.timesCompleted is int && data.timesCompleted >= 0
        && data.chaptersCycle is int && data.chaptersCycle >= 0
        && data.completedBooks is int
        && data.completedBooks >= 0 && data.completedBooks <= 73
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['completedBookIds'])
          || (data.completedBookIds is list && data.completedBookIds.size() <= 73));
    }
  }
}
