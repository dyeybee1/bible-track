                  13,
                  13
                ],
                "app_verse_start": 1,
                "text_start": "The great King Ahasuerus sends greetings",
                "text_end": "Many who have been frequently honored"
              },
              {
                "source_book": "est",
                "source_chapter": 8,
                "source_verses": [
                  13,
                  13
                ],
                "app_verse_start": 2,
                "text_start": "Many who have been frequently honored",
                "text_end": "and not only endeavor to hurt our subjects"
              },
              {
                "source_book": "est",
                "source_chapter": 8,
                "source_verses": [
                  13,
                  13
                ],
                "app_verse_start": 3,
                "text_start": "and not only endeavor to hurt our subjects",
                "text_end": "They not only would utterly abolish gratitude"
              },
              {
                "source_book": "est",
                "source_chapter": 8,
                "source_verses": [
                  13,
                  13
                ],
                "app_verse_start": 4,
                "text_start": "They not only would utterly abolish gratitude",
                "text_end": "And oftentimes evil exhortation"
              },
              {
                "source_book": "est",
                "source_chapter": 8,
                "source_verses": [
                  13,
                  13
                ],
                "app_verse_start": 5,
                "text_start": "And oftentimes evil exhortation",
                "text_end": "while men, by the false sophistry"
              },
              {
                "source_book": "est",
                "source_chapter": 8,
                "source_verses": [
                  13,
                  13
                ],
                "app_verse_start": 6,
                "text_start": "while men, by the false sophistry",
                "text_end": "And it is possible to see this"
